# =============================================================================
# NEVER COMMIT A FILLED-IN COPY OF THIS FILE.
#
# makemytrip-backend/.env.production was committed to a public repository once
# already (commit 7a28d2b) and leaked live SMTP, Razorpay and RapidAPI keys.
# The server now refuses to boot if any of those published values is still in
# use — see src/config/secrets.js and SECURITY_ROTATION.md.
# =============================================================================

# Server Config
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ============ TRUST PROXY (required whenever a proxy sits in front) ==========
# How many reverse proxies append to X-Forwarded-For between the internet and
# this process. Without it req.ip is the proxy's address, so every client shares
# a single rate-limit bucket and per-IP limits protect nobody.
#
#   (unset)/false/none  direct connections — correct for local development
#   1                   one proxy (nginx, Render, Railway, Heroku, AWS ALB,
#                       Azure App Service, DigitalOcean, GCP LB, Cloudflare)
#   2                   two proxies (Cloudflare -> your nginx, CloudFront -> ALB)
#
# Named shortcuts are also accepted and resolve to the hop counts above:
#   nginx, cloudflare, cloudflare-nginx, render, railway, heroku, aws, aws-alb,
#   aws-cloudfront-alb, azure, azure-frontdoor, digitalocean, do, gcp, gcp-lb
#
# An explicit proxy allowlist works too: TRUST_PROXY=10.0.0.0/8,172.18.0.0/16
#
# TRUST_PROXY=true is REJECTED at startup: it makes the client-supplied
# X-Forwarded-For authoritative, letting anyone forge an IP and evade limits.
# The docker-compose.prod.yml topology (nginx -> backend) needs TRUST_PROXY=1.
TRUST_PROXY=

# JWT — signs auth tokens AND price quotes. Minimum 32 characters; the server
# will not start with anything shorter or with the placeholder below.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this logs every user out and invalidates in-flight price quotes
# (customers simply re-quote).
JWT_SECRET=your_jwt_secret_key_change_in_production

# Access-token lifetime. Deliberately NOT named JWT_EXPIRE: revocation is only
# checked when a guard reads the user document, so an access token has to stay
# short — the server refuses to start above 24h. Long sessions come from the
# refresh token below, not from stretching this.
# Accepts s/m/h/d, e.g. 15m, 1h, 12h.
ACCESS_TOKEN_TTL=1h

# Refresh-token lifetime, in days. This is what keeps a user signed in; it
# rotates on every use and can be revoked server-side at any time.
REFRESH_TOKEN_TTL_DAYS=30

# ============ FLIGHT APIs ============

# Amadeus API
# Signup: https://developers.amadeus.com
# Get token from: https://api.amadeus.com/v1/security/oauth2/token
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
AMADEUS_TOKEN=your_amadeus_token

# Skyscanner API (RapidAPI)
# Signup: https://rapidapi.com/skyscanner/api/skyscanner
# Free tier available, get key from dashboard
SKYSCANNER_API_KEY=your_skyscanner_api_key

# ============ HOTEL APIs ============

# Booking.com
# Signup: https://affiliate.booking.com/en-gb/partners/partner-sign-up
# Get API key from partner dashboard
BOOKING_API_KEY=your_booking_api_key
BOOKING_AFFILIATE_ID=your_booking_affiliate_id

# Agoda
# Signup: https://partners.agoda.com/en-in/
# Contact for API access
AGODA_API_KEY=your_agoda_api_key

# Expedia EAN
# Signup: https://www.expediaaffiliate.com/en-us/signup
EXPEDIA_API_KEY=your_expedia_api_key
EXPEDIA_API_SECRET=your_expedia_api_secret

# ============ BUS APIs ============

# GoIbibo
# Signup: https://www.goibibo.com/api/
# Email: partnerships@goibibo.com for API access
GOIBIBO_API_KEY=your_goibibo_api_key
GOIBIBO_PARTNER_ID=your_goibibo_partner_id

# 12Go.asia
# Signup: https://12go.asia/en/affiliate
TWELVEGO_API_KEY=your_12go_api_key

# ============ CAB/RIDE APIs ============

# Uber
# Signup: https://developer.uber.com/dashboard
# Get access token from developer dashboard
UBER_CLIENT_ID=your_uber_client_id
UBER_CLIENT_SECRET=your_uber_client_secret
UBER_ACCESS_TOKEN=your_uber_access_token

# Ola
# Signup: https://partners.olacabs.com
# Email: partner.ecosystem@olaelectric.com for API setup
OLA_API_KEY=your_ola_api_key
OLA_CLIENT_ID=your_ola_client_id

# ============ CACHING ============
CACHE_TTL=300

# ============ FIREBASE (Optional - for bookings/users) ============
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY=your_private_key

# ============ SMTP / EMAIL (required for all transactional email) ============
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 characters below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM_NAME=MakeMyTrip
# Gmail rewrites From: to SMTP_USER unless this is a verified alias.
SMTP_FROM_EMAIL=your_gmail_address@gmail.com
SMTP_MAX_CONNECTIONS=3
EMAIL_MAX_ATTEMPTS=3


# ============ SMS / MOBILE OTP ============
# twilio is the only supported provider.
SMS_PROVIDER=twilio
SMS_DEFAULT_COUNTRY_CODE=91

# https://console.twilio.com → Account SID, Auth Token, and a Messaging-capable number.
# On a trial account you must first verify each destination number under
# Phone Numbers → Verified Caller IDs.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional: use a Messaging Service instead of a single From number
TWILIO_MESSAGING_SERVICE_SID=

# ============ OTP POLICY ============
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=5
# Extra secret mixed into the OTP hash. Defaults to JWT_SECRET when unset, but
# set a dedicated value so rotating JWT_SECRET does not invalidate live OTPs.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OTP_PEPPER=

# ============ BRANDING (email templates) ============
BRAND_NAME=MakeMyTrip
BRAND_TAGLINE=India's Travel Partner
# Publicly reachable logo URL. Leave empty to use the built-in image-free wordmark.
BRAND_LOGO_URL=
APP_BASE_URL=http://localhost:5173
SUPPORT_EMAIL=support@makemytrip.com
SUPPORT_PHONE=+91 1800 102 8747
ADMIN_EMAIL=

# ============ RATE LIMITING ============
# Six policies, all defined in src/middleware/rateLimiter.js. Routes pick one;
# none define their own. Raise these only for a deliberate load/test run.
#
# Buckets are keyed on the ACCOUNT once a request is authenticated, and on the
# client address otherwise — so a shared corporate NAT does not put thousands of
# customers in one bucket. Correct client-address resolution depends on
# TRUST_PROXY above.
#
# Every 429 carries a Retry-After header, RateLimit-* headers, and a body of
# { success:false, code:"RATE_LIMITED", message, retryAfter }.

# Global flood ceiling, applied to every route ahead of the policies below.
# Deliberately generous: it caps abuse and must never be what a legitimate
# session hits first. /health is exempt so load-balancer probes are never dropped.
RATE_LIMIT_BASELINE_MAX=300
RATE_LIMIT_BASELINE_WINDOW_MS=60000

# Credential endpoints: login, registration, password reset, admin/vendor sign-in.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000

# OTP issuance and verification.
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_OTP_WINDOW_MS=900000

# Inventory search and autocomplete.
RATE_LIMIT_SEARCH_MAX=60
RATE_LIMIT_SEARCH_WINDOW_MS=60000

# Ordinary reads: profiles, dashboards, documents, admin panel.
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW_MS=60000

# Writes: bookings, payment quote/order/verify, tickets, reviews, coupon checks.
RATE_LIMIT_CREATE_MAX=30
RATE_LIMIT_CREATE_WINDOW_MS=60000

# Multipart uploads (10 MB cap each, so this is a bandwidth budget).
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
