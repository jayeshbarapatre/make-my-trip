# Server Config
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/makemytrip

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production

# ============ FLIGHT APIs ============

# Amadeus API
# Signup: https://developers.amadeus.com
# Get token from: https://api.amadeus.com/v1/security/oauth2/token
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
AMADEUS_TOKEN=your_amadeus_token

# Skyscanner API (RapidAPI)
# Signup: https://rapidapi.com/skyscanner/api/skyscanner
# Free tier available, get key from dashboard
SKYSCANNER_API_KEY=your_skyscanner_api_key

# ============ HOTEL APIs ============

# Booking.com
# Signup: https://affiliate.booking.com/en-gb/partners/partner-sign-up
# Get API key from partner dashboard
BOOKING_API_KEY=your_booking_api_key
BOOKING_AFFILIATE_ID=your_booking_affiliate_id

# Agoda
# Signup: https://partners.agoda.com/en-in/
# Contact for API access
AGODA_API_KEY=your_agoda_api_key

# Expedia EAN
# Signup: https://www.expediaaffiliate.com/en-us/signup
EXPEDIA_API_KEY=your_expedia_api_key
EXPEDIA_API_SECRET=your_expedia_api_secret

# ============ BUS APIs ============

# GoIbibo
# Signup: https://www.goibibo.com/api/
# Email: partnerships@goibibo.com for API access
GOIBIBO_API_KEY=your_goibibo_api_key
GOIBIBO_PARTNER_ID=your_goibibo_partner_id

# 12Go.asia
# Signup: https://12go.asia/en/affiliate
TWELVEGO_API_KEY=your_12go_api_key

# ============ CAB/RIDE APIs ============

# Uber
# Signup: https://developer.uber.com/dashboard
# Get access token from developer dashboard
UBER_CLIENT_ID=your_uber_client_id
UBER_CLIENT_SECRET=your_uber_client_secret
UBER_ACCESS_TOKEN=your_uber_access_token

# Ola
# Signup: https://partners.olacabs.com
# Email: partner.ecosystem@olaelectric.com for API setup
OLA_API_KEY=your_ola_api_key
OLA_CLIENT_ID=your_ola_client_id

# ============ CACHING ============
CACHE_TTL=300

# ============ FIREBASE (Optional - for bookings/users) ============
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY=your_private_key
