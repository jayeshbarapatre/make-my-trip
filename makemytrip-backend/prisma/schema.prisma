datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  phone         String
  password      String
  is_admin      Boolean   @default(false)
  is_vendor     Boolean   @default(false)
  vendorType    String?   // "hotel" | "airline" | "multi"
  vendorName    String?
  vendorStatus  String    @default("ACTIVE") // "ACTIVE" | "SUSPENDED"
  otp           String?
  otpExpiry     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
  hotels        Hotel[]   @relation("HotelVendor")
  flights       Flight[]  @relation("FlightVendor")
}

model Booking {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String   // "flight" | "hotel"
  fromCity      String
  toCity        String
  departureDate String
  returnDate    String?
  travellers    Json
  totalAmount   Float
  status        String   @default("confirmed") // "confirmed" | "cancelled"
  bookingId     String   @unique
  pnr           String
  createdAt     DateTime @default(now())
}

model Flight {
  id              String   @id @default(uuid())
  airline         String
  flightNumber    String   @unique
  from            String?
  to              String?
  departureTime   String?
  arrivalTime     String?
  durationMinutes Int?
  departure       Json?    // { city, time }
  arrival         Json?    // { city, time }
  duration        String?
  price           Float
  seats           Int      @default(180)
  seatsAvailable  Int      @default(180)
  baggage         Int?
  stops           Int      @default(0)
  aircraft        String?
  image           String?
  vendorId        String?
  vendor          User?    @relation("FlightVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  listingStatus   String   @default("DRAFT") // "DRAFT" | "PENDING_APPROVAL" | "APPROVED" | "REJECTED"
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Hotel {
  id              String   @id @default(uuid())
  name            String
  city            String
  location        String?
  description     String?
  image           String?
  images          Json?
  rating          Float    @default(4.0)
  reviews         Int      @default(0)
  price           Float
  pricePerNight   Float
  rooms           Int      @default(50)
  roomsAvailable  Int      @default(50)
  amenities       Json?
  checkin         String?
  checkout        String?
  isActive        Boolean  @default(true)
  vendorId        String?
  vendor          User?    @relation("HotelVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  listingStatus   String   @default("DRAFT") // "DRAFT" | "PENDING_APPROVAL" | "APPROVED" | "REJECTED"
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  roomCategories  RoomCategory[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RoomCategory {
  id              String   @id @default(uuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  categoryName    String
  description     String?
  capacity        Int      @default(2)
  totalRooms      Int
  availableRooms  Int
  basePrice       Float
  amenities       Json?
  images          Json?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
