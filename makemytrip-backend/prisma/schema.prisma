datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String    @unique
  phone         String
  password      String
  is_admin      Boolean   @default(false)
  is_vendor     Boolean   @default(false)
  vendorType    String?   // "hotel" | "airline" | "multi"
  vendorName    String?
  vendorStatus  String    @default("ACTIVE") // "ACTIVE" | "SUSPENDED"
  otp           String?
  otpExpiry     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
  hotels        Hotel[]   @relation("HotelVendor")
  buses         Bus[]     @relation("BusVendor")
  cabs          Cab[]     @relation("CabVendor")
}

model Booking {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String   // "flight" | "hotel" | "train" | "bus" | "cab"
  fromCity        String
  toCity          String
  departureDate   String
  returnDate      String?

  // Traveller & Passenger Info
  travellers      Json     // { adults, children, infants, passengers: [...] }
  passengers      Json?    // Array of passenger objects with name, age, gender, seat, meal pref

  // Flight/Service Details
  airlineName     String?
  airlineCode     String?
  flightNumber    String?
  trainNumber     String?
  busNumber       String?
  cabType         String?
  pnr             String
  bookingId       String   @unique

  // Route & Journey Details
  departureTime   String?
  arrivalTime     String?
  departureAirport String?
  arrivalAirport  String?
  departureTerminal String?
  arrivalTerminal String?
  boardingTime    String?
  stops           Int      @default(0)
  cabinClass      String?  // Economy, Business, First, etc.
  numBags         Int      @default(1)
  travelInsurance Boolean  @default(false)

  // Fare Breakdown
  baseFare        Float    @default(0)
  taxes           Float    @default(0)
  convenience     Float    @default(0)
  discount        Float    @default(0)
  couponCode      String?
  gst             Float    @default(0)
  totalAmount     Float

  // Payment Details
  paymentMethod   String?  // "credit_card" | "debit_card" | "upi" | "wallet" | "cash"
  paymentStatus   String   @default("completed") // "pending" | "completed" | "failed"
  transactionId   String?

  // Booking Status
  status          String   @default("confirmed") // "confirmed" | "cancelled" | "completed"

  createdAt       DateTime @default(now())
}

model Flight {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  airline         String
  flightNumber    String   @unique
  from            String?
  to              String?
  departureTime   String?
  arrivalTime     String?
  durationMinutes Int?
  departure       Json?    // { city, time }
  arrival         Json?    // { city, time }
  duration        String?
  price           Float
  seats           Int      @default(180)
  seatsAvailable  Int      @default(180)
  baggage         Int?
  stops           Int      @default(0)
  aircraft        String?
  image           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Hotel {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  city            String
  location        String?
  description     String?
  image           String?
  images          Json?
  rating          Float    @default(4.0)
  reviews         Int      @default(0)
  price           Float
  pricePerNight   Float
  rooms           Int      @default(50)
  roomsAvailable  Int      @default(50)
  roomTypes       Json?
  amenities       Json?
  checkin         String?
  checkout        String?
  isActive        Boolean  @default(true)
  vendorId        String?  @db.ObjectId
  vendor          User?    @relation("HotelVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  listingStatus   String   @default("DRAFT") // "DRAFT" | "PENDING_APPROVAL" | "APPROVED" | "REJECTED"
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  roomCategories  RoomCategory[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RoomCategory {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  hotelId         String   @db.ObjectId
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  categoryName    String
  description     String?
  capacity        Int      @default(2)
  totalRooms      Int
  availableRooms  Int
  basePrice       Float
  amenities       Json?
  images          Json?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Bus {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  vendorId        String?  @db.ObjectId
  vendor          User?    @relation("BusVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  operatorName    String
  busNumber       String   @unique
  type            String
  departure       Json?
  arrival         Json?
  durationMinutes Int?
  price           Float
  seats           Int      @default(45)
  seatsAvailable  Int      @default(45)
  amenities       Json?
  image           String?
  isActive        Boolean  @default(true)
  listingStatus   String   @default("DRAFT")
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Cab {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  vendorId        String?  @db.ObjectId
  vendor          User?    @relation("CabVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  operatorName    String
  cabNumber       String   @unique
  type            String   // 'Economy', 'Premium', 'XL', 'Luxury'
  baseFare        Float
  perKmRate       Float
  perMinuteRate   Float
  location        String?
  currentCity     String?
  cabs            Int      @default(20)
  cabsAvailable   Int      @default(20)
  image           String?
  isActive        Boolean  @default(true)
  listingStatus   String   @default("DRAFT")
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Train {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  operatorName    String
  trainNumber     String   @unique
  type            String
  departure       Json?
  arrival         Json?
  durationMinutes Int?
  price           Float
  seats           Int      @default(400)
  seatsAvailable  Int      @default(400)
  amenities       Json?
  image           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CmsPage {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  slug             String   @unique
  metaTitle        String?
  metaDescription  String?
  metaKeywords     String?
  ogImage          String?
  canonicalUrl     String?
  schemaJson       String?
  bannerImage      String?
  shortDescription String?
  content          String
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model FooterSection {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  sortOrder Int           @default(0)
  status    String        @default("active")
  links     FooterLink[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model FooterLink {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  sectionId   String        @db.ObjectId
  section     FooterSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title       String
  url         String?
  cmsPageId   String?
  target      String        @default("_self")
  sortOrder   Int           @default(0)
  status      String        @default("active")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ContactInquiry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  message     String
  type        String
  referenceId String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model JobPosition {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  department   String
  location     String
  experience   String
  description  String
  status       String           @default("active")
  applications JobApplication[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model JobApplication {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  jobId     String      @db.ObjectId
  job       JobPosition @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String?
  resume    String?
  message   String?
  status    String      @default("pending")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Faq {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  question  String
  answer    String
  sortOrder Int      @default(0)
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  primaryColor        String   @default("#003580")
  secondaryColor      String   @default("#0F172A")
  accentColor         String   @default("#1a73e8")
  footerBg            String   @default("#003580")
  headerBg            String   @default("#ffffff")
  logo                String?
  favicon             String?
  announcementBar     String?
  announcementActive  Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model MediaLibrary {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fileName  String
  fileUrl   String
  fileType  String
  size      Int
  createdAt DateTime @default(now())
}
