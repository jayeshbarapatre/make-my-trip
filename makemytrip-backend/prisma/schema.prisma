datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  phone     String
  password  String
  is_admin  Boolean   @default(false)
  otp       String?
  otpExpiry DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
}

model Booking {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String   // "flight" | "hotel"
  fromCity      String
  toCity        String
  departureDate String
  returnDate    String?
  travellers    Json
  totalAmount   Float
  status        String   @default("confirmed") // "confirmed" | "cancelled"
  bookingId     String   @unique
  pnr           String
  createdAt     DateTime @default(now())
}

model Flight {
  id              String   @id @default(uuid())
  airline         String
  flightNumber    String   @unique
  departure       Json     // { city, time }
  arrival         Json     // { city, time }
  duration        String?
  price           Float
  seats           Int      @default(180)
  seatsAvailable  Int      @default(180)
  baggage         Int?
  stops           Int      @default(0)
  aircraft        String?
  image           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
