datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  phone         String
  password      String
  is_admin      Boolean   @default(false)
  is_vendor     Boolean   @default(false)
  vendorType    String?   // "hotel" | "airline" | "multi"
  vendorName    String?
  vendorStatus  String    @default("ACTIVE") // "ACTIVE" | "SUSPENDED"
  otp           String?
  otpExpiry     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
  hotels        Hotel[]   @relation("HotelVendor")
  buses         Bus[]     @relation("BusVendor")
  cabs          Cab[]     @relation("CabVendor")

  @@index([email])
  @@index([phone])
  @@index([is_admin])
}

model Booking {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String   // "flight" | "hotel" | "train" | "bus" | "cab"
  flightId      String?  // Store flight ID for refund on cancellation
  hotelId       String?  // Store hotel ID for refund on cancellation
  fromCity      String
  toCity        String
  departureDate String
  returnDate    String?
  travellers    Json     // Contains passenger/room details and counts
  totalAmount   Float
  status        String   @default("confirmed") // "confirmed" | "cancelled"
  bookingId     String   @unique
  pnr           String
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([flightId])
  @@index([hotelId])
  @@index([createdAt])
}

model Flight {
  id              String   @id @default(uuid())
  airline         String
  flightNumber    String   @unique
  from            String?
  to              String?
  departureTime   String?
  arrivalTime     String?
  durationMinutes Int?
  departure       Json?    // { city, time }
  arrival         Json?    // { city, time }
  duration        String?
  price           Float
  seats           Int      @default(180)
  seatsAvailable  Int      @default(180) // Constraint: must be >= 0 and <= seats
  baggage         Int?
  stops           Int      @default(0)
  aircraft        String?
  image           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([airline])
  @@index([isActive])
}

model Hotel {
  id              String   @id @default(uuid())
  name            String
  city            String
  location        String?
  description     String?
  image           String?
  images          Json?
  rating          Float    @default(4.0)
  reviews         Int      @default(0)
  price           Float
  pricePerNight   Float
  rooms           Int      @default(50)
  roomsAvailable  Int      @default(50) // Constraint: must be >= 0 and <= rooms
  roomTypes       Json?
  amenities       Json?
  checkin         String?
  checkout        String?
  isActive        Boolean  @default(true)
  vendorId        String?
  vendor          User?    @relation("HotelVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  listingStatus   String   @default("DRAFT") // "DRAFT" | "PENDING_APPROVAL" | "APPROVED" | "REJECTED"
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  roomCategories  RoomCategory[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([city])
  @@index([isActive])
  @@index([vendorId])
}

model RoomCategory {
  id              String   @id @default(uuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  categoryName    String
  description     String?
  capacity        Int      @default(2)
  totalRooms      Int
  availableRooms  Int
  basePrice       Float
  amenities       Json?
  images          Json?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Bus {
  id              String   @id @default(uuid())
  vendorId        String?
  vendor          User?    @relation("BusVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  operatorName    String
  busNumber       String   @unique
  type            String
  departure       Json?
  arrival         Json?
  durationMinutes Int?
  price           Float
  seats           Int      @default(45)
  seatsAvailable  Int      @default(45)
  amenities       Json?
  image           String?
  isActive        Boolean  @default(true)
  listingStatus   String   @default("DRAFT")
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Cab {
  id              String   @id @default(uuid())
  vendorId        String?
  vendor          User?    @relation("CabVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  operatorName    String
  cabNumber       String   @unique
  type            String   // 'Economy', 'Premium', 'XL', 'Luxury'
  baseFare        Float
  perKmRate       Float
  perMinuteRate   Float
  location        String?
  currentCity     String?
  cabs            Int      @default(20)
  cabsAvailable   Int      @default(20)
  image           String?
  isActive        Boolean  @default(true)
  listingStatus   String   @default("DRAFT")
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Train {
  id              String   @id @default(uuid())
  operatorName    String
  trainNumber     String   @unique
  type            String
  departure       Json?
  arrival         Json?
  durationMinutes Int?
  price           Float
  seats           Int      @default(400)
  seatsAvailable  Int      @default(400)
  amenities       Json?
  image           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CmsPage {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  metaTitle        String?
  metaDescription  String?
  metaKeywords     String?
  ogImage          String?
  canonicalUrl     String?
  schemaJson       String?
  bannerImage      String?
  shortDescription String?
  content          String   @db.Text
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model FooterSection {
  id        String        @id @default(uuid())
  title     String
  sortOrder Int           @default(0)
  status    String        @default("active")
  links     FooterLink[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model FooterLink {
  id          String        @id @default(uuid())
  sectionId   String
  section     FooterSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title       String
  url         String?
  cmsPageId   String?
  target      String        @default("_self")
  sortOrder   Int           @default(0)
  status      String        @default("active")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ContactInquiry {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id          String   @id @default(uuid())
  title       String
  message     String   @db.Text
  type        String
  referenceId String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model JobPosition {
  id           String           @id @default(uuid())
  title        String
  department   String
  location     String
  experience   String
  description  String           @db.Text
  status       String           @default("active")
  applications JobApplication[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model JobApplication {
  id        String      @id @default(uuid())
  jobId     String
  job       JobPosition @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String?
  resume    String?
  message   String?     @db.Text
  status    String      @default("pending")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String   @db.Text
  sortOrder Int      @default(0)
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id                  String   @id @default(uuid())
  primaryColor        String   @default("#003580")
  secondaryColor      String   @default("#0F172A")
  accentColor         String   @default("#1a73e8")
  footerBg            String   @default("#003580")
  headerBg            String   @default("#ffffff")
  logo                String?
  favicon             String?
  announcementBar     String?
  announcementActive  Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model MediaLibrary {
  id        String   @id @default(uuid())
  fileName  String
  fileUrl   String
  fileType  String
  size      Int
  createdAt DateTime @default(now())
}
