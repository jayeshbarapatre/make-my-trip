rules_version = '2';

// Firestore security rules.
//
// ── How access actually works here ──
//
// Every read and write goes through the Express API using the Firebase Admin
// SDK, which bypasses these rules entirely. Authorization is enforced in
// `middleware/rbac.js` (roles, permissions, ownership) and re-read from the
// user document on every request.
//
// Critically: this platform authenticates with its OWN JWTs, signed with
// JWT_SECRET — not with Firebase Authentication. `request.auth` is therefore
// ALWAYS null for any client, and no `request.auth.uid` comparison here could
// ever evaluate true. An earlier version of this file was written as though
// Firebase Auth were in use, with owner-scoped rules like
// `request.auth.uid == resource.data.userId`. Those read as though client
// access worked and was safely scoped; in reality they were unreachable code
// that always denied. They have been replaced with explicit denial so the file
// states what it does.
//
// These rules are not the authorization model. They are the backstop that keeps
// the database unreachable if someone points a client SDK at it using the
// project config, which is public by definition.
//
// Verified: no Firebase client SDK is installed or imported anywhere in
// makemytrip-frontend, and there are no VITE_FIREBASE_* variables.
// `tests/audit.test.mjs` pins both that and the contents of this file.
//
// ── If a client SDK is ever introduced ──
//
// Do not simply relax these rules. Firebase Auth would first have to become the
// identity provider, or the API would have to mint Firebase custom tokens
// carrying the user id. Only then can an owner check be written that means
// anything. Until that exists, opening any rule here opens it to everyone.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Catalog ──
    //
    // These were `allow read: if true`. That let anyone holding the project id
    // bulk-export the entire inventory — 430 hotels, 509 trains, 250 cabs, 162
    // flights — directly from Firestore, bypassing the API's rate limiting,
    // pagination and availability filtering. Nothing required it: the catalog is
    // served by GET /api/v1/{flights,hotels,buses,trains,cabs}.
    match /flights/{id}          { allow read, write: if false; }
    match /hotels/{id}           { allow read, write: if false; }
    match /buses/{id}            { allow read, write: if false; }
    match /trains/{id}           { allow read, write: if false; }
    match /cabs/{id}             { allow read, write: if false; }
    match /room_categories/{id}  { allow read, write: if false; }

    // ── Identity and credentials ──
    //
    // `users` holds bcrypt password hashes; `sessions` holds the hash of a live
    // refresh token, so a read there is a step towards session theft and a write
    // is session forgery; `otps` holds live one-time codes.
    match /users/{email}         { allow read, write: if false; }
    match /sessions/{id}         { allow read, write: if false; }
    match /otps/{id}             { allow read, write: if false; }

    // ── Money ──
    //
    // Bookings and payments carry passenger names, contact details and captured
    // amounts. Refund state is decided by `refundService`, never by a client.
    match /bookings/{id}         { allow read, write: if false; }
    match /payments/{id}         { allow read, write: if false; }
    match /refunds/{id}          { allow read, write: if false; }

    // Coupons: a readable collection would let anyone enumerate unlisted codes,
    // their discounts and their remaining redemptions.
    match /coupons/{id}          { allow read, write: if false; }

    // ── Operational ──
    //
    // audit_logs carries other actors' IP addresses and email addresses, and a
    // forgeable audit log is worse than none.
    match /audit_logs/{id}       { allow read, write: if false; }
    match /emailLogs/{id}        { allow read, write: if false; }
    match /settings/{id}         { allow read, write: if false; }
    match /notifications/{id}    { allow read, write: if false; }

    // ── User-generated content ──
    //
    // Reviews are published through GET /api/v1/reviews/subject/:id, which
    // applies the same status filter server-side. Reading them straight from
    // Firestore added nothing and exposed the collection to enumeration.
    match /reviews/{id}          { allow read, write: if false; }
    match /wishlists/{id}        { allow read, write: if false; }
    match /support_tickets/{id}  { allow read, write: if false; }
    match /vendor_requests/{id}  { allow read, write: if false; }
    match /cms_pages/{id}        { allow read, write: if false; }
    match /email_templates/{id}  { allow read, write: if false; }

    // ── Default: deny anything not named above ──
    //
    // This already covers every collection listed here. They are enumerated
    // anyway so that a future collection added without a rule is visibly
    // missing from this file, rather than silently inheriting a default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
