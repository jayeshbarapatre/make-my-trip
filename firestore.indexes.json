          "fieldPath": "fromCanonical",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "toCanonical",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "price",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "trains: route + cheapest-first, for server-side sorting",
      "collectionGroup": "trains",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "fromCanonical",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "toCanonical",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "price",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "buses: route + cheapest-first, for server-side sorting",
      "collectionGroup": "buses",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "fromCanonical",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "toCanonical",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "price",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "cabs: route + cheapest-first, for server-side sorting",
      "collectionGroup": "cabs",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "fromCanonical",
          "order": "ASCENDING"
        },
        {
