{
  "//": [
    "Composite indexes for this project.",
    "",
    "Firestore creates single-field indexes automatically and resolves multiple",
    "equality filters without a composite (it merges the single-field indexes).",
    "A composite is only required when a query combines an equality filter with",
    "an orderBy or a range on a DIFFERENT field.",
    "",
    "Inventory search therefore needs NO composite: it filters on",
    "fromCanonical + toCanonical + isActive, which are three equality filters.",
    "Those fields are denormalised onto every document by",
    "scripts/backfillRouteIndex.js and written on create by the admin/vendor",
    "factories. The fieldOverrides below keep them indexed and exclude the large",
    "text fields that would otherwise be indexed for nothing.",
    "",
    "Prerequisite: date fields indexed here MUST be a single type. They were a",
    "mix of ISO strings and Timestamps, which Firestore orders by type before",
    "value \u2014 `npm run migrate:timestamps` normalises them."
  ],
  "indexes": [
    {
      "//": "getUserBookings \u2014 My Trips, newest first",
      "collectionGroup": "bookings",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Admin bookings list filtered by status, newest first",
      "collectionGroup": "bookings",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Reports and dashboard revenue \u2014 vendor-scoped over a date range",
      "collectionGroup": "bookings",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "vendorId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "listMyRefunds \u2014 customer's own refunds, newest first",
      "collectionGroup": "refunds",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Admin refund queue filtered by status",
      "collectionGroup": "refunds",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Support inbox \u2014 customer thread, newest first",
      "collectionGroup": "support_tickets",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Support inbox \u2014 admin queue by status",
      "collectionGroup": "support_tickets",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Vendor onboarding queue by status",
      "collectionGroup": "vendor_requests",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Listing approval queues (hotels, buses, cabs share this shape)",
      "collectionGroup": "hotels",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "listingStatus",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Vendor's own inventory, newest first",
      "collectionGroup": "hotels",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "vendorId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Email log admin screen \u2014 failures first, newest first",
      "collectionGroup": "emailLogs",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Audit trail scoped to one entity, newest first",
      "collectionGroup": "audit_logs",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "entity",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
