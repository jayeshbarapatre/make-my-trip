.DS_Store

# Environment files — never commit real credentials.
#
# makemytrip-backend/.env.production was previously tracked and leaked live
# Supabase, SMTP, Razorpay and RapidAPI credentials to a public repository.
# Backend env files hold secrets and are ignored outright; the frontend's
# .env.production is intentionally tracked because Vite only exposes VITE_*
# values, which ship in the client bundle and are public by definition.
makemytrip-backend/.env
makemytrip-backend/.env.*
!makemytrip-backend/.env.example
serviceAccountKey.json
*.log

# Local Firestore emulator state. Written by `npm run emulator` so that local
# accounts survive a restart; it is developer data, not source.
.emulator-data/
firebase-debug.log
firestore-debug.log
